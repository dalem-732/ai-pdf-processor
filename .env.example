# ---------------------------------------------------------------------------
# Скопируйте файл в `.env` и заполните значения под свой стенд.
# Все переменные читаются классом Settings (app/config.py) с префиксом TENDER_.
# ---------------------------------------------------------------------------

# Какой бэкенд LLM использовать: openai | anthropic | ollama | stub
# `stub` не требует сети и ключей: выжимка собирается детерминированными
# эвристиками. Удобно для локальной проверки API и для тестов.
TENDER_LLM_PROVIDER=ollama

# --- OpenAI ---------------------------------------------------------------
TENDER_OPENAI_API_KEY=
TENDER_OPENAI_MODEL=gpt-4o-mini
TENDER_OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic ------------------------------------------------------------
TENDER_ANTHROPIC_API_KEY=
TENDER_ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# Для Claude Opus 4.7+, Sonnet 4.6+ и Sonnet 5 клиент не отправляет
# temperature и assistant-prefill «{» - API вернёт 400.
TENDER_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# --- Ollama (бесплатная локальная модель) ---------------------------------
# Пример: ollama pull qwen2.5:7b-instruct
TENDER_OLLAMA_MODEL=qwen2.5:7b-instruct
TENDER_OLLAMA_BASE_URL=http://localhost:11434

# --- Ограничения обработки ------------------------------------------------
# Максимальный размер загружаемого PDF, МБ.
TENDER_MAX_UPLOAD_MB=25
# Размер одного чанка текста в символах и перекрытие между чанками.
TENDER_CHUNK_CHARS=12000
TENDER_CHUNK_OVERLAP_CHARS=800
# Сколько наиболее релевантных чанков отдавать в LLM (защита от гигантских
# документов и от неконтролируемого расхода токенов).
TENDER_MAX_CHUNKS=20
# Таймаут одного запроса к LLM, секунды, и число повторов при сетевых сбоях.
TENDER_LLM_TIMEOUT_SECONDS=120
TENDER_LLM_MAX_RETRIES=2
TENDER_LLM_TEMPERATURE=0.0
TENDER_LLM_MAX_OUTPUT_TOKENS=4000

# --- Сервис ---------------------------------------------------------------
TENDER_LOG_LEVEL=INFO
